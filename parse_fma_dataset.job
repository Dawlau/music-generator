#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus-per-node=2
#SBATCH --job-name=ParseFMA
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=01:00:00
#SBATCH --output=test.out

module purge
module load 2023
module load Anaconda3/2023.07-2
module load FFmpeg/6.0-GCCcore-12.3.0

cd $HOME/music-generator

source activate music-generator

cd parse_dataset

srun python parse_fma_data.py \
--compute_songs_features \
--move_songs_files \
--generate_clap_features \
--build_dataset